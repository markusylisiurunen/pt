{
  "tasks": {
    "check": "deno fmt --check main.ts lib deno.json && deno task lint && deno check main.ts && deno task test && deno task web:check",
    "dev": "deno serve --env-file --watch -A main.ts",
    "lint": "deno lint main.ts lib",
    "test": "deno test --allow-env --allow-read --allow-write",
    "web:check": "npm run lint --prefix web && npm run build --prefix web"
  },
  "fmt": {
    "lineWidth": 100
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.112.3",
    "@google/genai": "npm:@google/genai@^2.16.0",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/http": "jsr:@std/http@^1.1.2",
    "pyodide": "npm:pyodide@^0.29.4",
    "zod": "npm:zod@^4.4.3"
  }
}
